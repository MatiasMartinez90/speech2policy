# CloudAcademy - Environment Variables Template
# Copy this file to .env.local and fill in your values

# API Gateway URL (nuevo backend AWS Lambda + Bedrock)
NEXT_PUBLIC_TUTOR_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/api

# Cognito Configuration
NEXT_PUBLIC_AUTH_USER_POOL_ID=us-east-1_YourPoolId
NEXT_PUBLIC_AUTH_WEB_CLIENT_ID=your-client-id
NEXT_PUBLIC_COGNITO_DOMAIN=your-cognito-domain
