# ========================================
# Terraform Backend Configuration Template
# ========================================
#
# IMPORTANTE: NO VERSIONAR CREDENCIALES REALES
#
# Para usar:
# 1. Copiar este archivo a terraform.tfvars
# 2. Rellenar con valores reales
# 3. terraform.tfvars está en .gitignore
#
# O mejor aún: usar GitHub Secrets en CI/CD
# ========================================

# Google OAuth Configuration (REQUIRED)
# Obtener de: https://console.cloud.google.com/apis/credentials
google_client_id     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
google_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Production URLs
production_callback_url = "https://proyectos.cloudacademy.ar"
production_logout_url   = "https://proyectos.cloudacademy.ar"

# PostgreSQL RDS Configuration (OPTIONAL - si usas RDS)
# db_host     = "your-rds-endpoint.region.rds.amazonaws.com"
# db_user     = "postgres"
# db_password = "your-secure-password"
# db_name     = "proyecto_cloudacademy"
# db_port     = "5432"

# Email Configuration
# from_email = "noreply@cloudacademy.ar"
