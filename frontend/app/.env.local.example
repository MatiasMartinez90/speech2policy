# Copy this file to .env.local and fill in the values

# API Gateway URL (from backend terraform output)
NEXT_PUBLIC_API_URL=https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com/dev

# Cognito Configuration (from frontend/terraform/backend output)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_COGNITO_DOMAIN=speech2policy-dev-auth-XXXXXXXX.auth.us-east-1.amazoncognito.com
